# Copier en .env (jamais commité) et remplacer les valeurs.

# Mot de passe de la base PostgreSQL (docker-compose).
POS_DB_PASSWORD=changez-moi

# Clé de signature des sessions, 32 caractères minimum. Générer par exemple avec :
#   openssl rand -base64 48
POS_JWT_SECRET=

# Mot de passe temporaire de l'admin au premier démarrage (vide = généré et affiché une fois).
POS_ADMIN_INITIAL_PASSWORD=

# true dès que l'application est servie en HTTPS (obligatoire en ligne).
POS_COOKIE_SECURE=true

# Origines autorisées à appeler l'API depuis un autre domaine (séparées par des virgules).
POS_CORS_ORIGINS=
